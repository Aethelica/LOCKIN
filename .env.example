# Copy to .env and paste your key. .env is gitignored; this file is not.
#   cp .env.example .env
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Only needed if your key is "identity-linked" (belongs to you rather than to a
# single workspace). Those keys must name the workspace every request acts in,
# and without it the API returns:
#   400 anthropic-workspace-id is required when authenticating with an
#       identity-linked API key
# Find the id in the Console URL when your workspace is open --
# https://platform.claude.com/workspaces/<id>/... -- it starts with "wrkspc_".
# Leave this commented out for an ordinary workspace-scoped key.
#ANTHROPIC_WORKSPACE_ID=wrkspc_your-workspace-id
